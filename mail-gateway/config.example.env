# VeriTrust API / trusted receiver
VERITRUST_API_BASE_URL=https://www.veritrustlab.in
VERITRUST_API_KEY=vtg_test_REPLACE_WITH_SCOPED_GATEWAY_KEY
VERITRUST_RECEIVER_SECRET=REPLACE_WITH_THE_SAME_32_PLUS_BYTE_SECRET_USED_BY_THE_API
# Optional: leave blank to use the authenticated organization's active integration.
VERITRUST_INTEGRATION_ID=

# Inbound SMTP listener. Bind to 127.0.0.1 unless you intentionally need LAN access.
VERITRUST_SMTP_LISTEN_HOST=127.0.0.1
VERITRUST_SMTP_LISTEN_PORT=2525
VERITRUST_SMTP_RECEIVER_ID=veritrust-smtp-gateway
VERITRUST_SMTP_AUTHSERV_ID=veritrust-smtp-gateway
# For LAN use, prefer a source-IP allowlist; if no client IP allowlist is set, remote listeners default to AUTH required.
VERITRUST_SMTP_ALLOWED_CLIENT_IPS=
VERITRUST_SMTP_REQUIRE_AUTH=false
VERITRUST_SMTP_AUTH_USERNAME=
VERITRUST_SMTP_AUTH_PASSWORD=

# Anti-open-relay controls. For LAN listeners, configure at least one allowlist.
VERITRUST_SMTP_ALLOWED_RECIPIENTS=receiver@example.test
VERITRUST_SMTP_ALLOWED_RECIPIENT_DOMAINS=example.test
VERITRUST_SMTP_ALLOW_ALL_RECIPIENTS=false

# Downstream SMTP server / receiver laptop
VERITRUST_SMTP_UPSTREAM_HOST=127.0.0.1
VERITRUST_SMTP_UPSTREAM_PORT=2526
VERITRUST_SMTP_UPSTREAM_SECURE=false
VERITRUST_SMTP_UPSTREAM_STARTTLS=auto
VERITRUST_SMTP_UPSTREAM_USERNAME=
VERITRUST_SMTP_UPSTREAM_PASSWORD=
VERITRUST_SMTP_UPSTREAM_TLS_SERVERNAME=
VERITRUST_SMTP_UPSTREAM_ALLOW_INVALID_TLS=false

# Enforcement
VERITRUST_SMTP_FORWARD_ACTIONS=allow,warn
VERITRUST_SMTP_DEFER_ACTIONS=manual_review,hold
VERITRUST_SMTP_DEGRADED_MODE=defer
VERITRUST_SMTP_API_FAILURE_MODE=defer
VERITRUST_SMTP_ADD_DECISION_HEADERS=true
VERITRUST_SMTP_ANALYSIS_TIMEOUT_MS=90000
# 4 KiB is reserved for the receiver-added trust-boundary headers before the 10 MiB API cap.
VERITRUST_SMTP_MAX_MESSAGE_BYTES=10481664
