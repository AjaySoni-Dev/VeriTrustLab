# VeriTrust server/runtime template. Never commit real secrets.
# Copy to your deployment environment and fill required values.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Model provider
HF_TOKEN=
# Optional Cortex model contract/config; MailGuard and Swift use pinned source contracts.
HF_MODEL_CONTRACTS=
HF_PHISHING_CORTEX_MODEL=

# Gateway / forensic integrity (32+ byte random secrets)
VERITRUST_CONTENT_HMAC_KEY=
VERITRUST_GATEWAY_DISPATCH_SECRET=
VERITRUST_WEBHOOK_ENCRYPTION_KEY=
VERITRUST_EMAIL_RECEIVER_SECRET=
VERITRUST_TRUSTED_AUTHSERV_IDS=veritrust-smtp-gateway

# Evidence Passport. Recommended in production; blank falls back to a purpose-separated
# Ed25519 key derived from VERITRUST_CONTENT_HMAC_KEY.
VERITRUST_EVIDENCE_SIGNING_PRIVATE_KEY=
VERITRUST_EVIDENCE_TRUSTED_KEY_IDS=

# Threat intelligence
VERITRUST_RDAP_PROVIDER=rdap.org
ABUSEIPDB_API_KEY=
VERITRUST_GEO_PROVIDER=

# Origin policy
VERITRUST_SITE_URL=https://www.veritrustlab.in
VERITRUST_ALLOWED_ORIGINS=https://www.veritrustlab.in,https://veritrustlab.in

# Optional commercial integrations
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
